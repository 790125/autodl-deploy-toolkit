# 训练用环境变量（复制为 .env 并填入自己的值）
# ⚠️ .env 已在 .gitignore 中排除，不要提交

# AutoDL 实例连接信息
AUTODL_HOST=connect.xxxx.seetacloud.com
AUTODL_PORT=00000
AUTODL_SSH_PASSWORD=

# HuggingFace 镜像（国内建议开启）
HF_ENDPOINT=https://hf-mirror.com

# 显存碎片治理（脚本内已设置，此处留作说明）
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# 长任务日志实时输出
PYTHONUNBUFFERED=1
